# Is file ka naam copy karke ".env" bana lena aur apni values daal dena

# MongoDB connection string
# Local ke liye:      mongodb://127.0.0.1:27017/sarkari-jobs
# MongoDB Atlas (free cloud DB) ke liye: unke dashboard se milega
MONGO_URI=mongodb://127.0.0.1:27017/sarkari-jobs

# Server kis port par chalega
PORT=5000

# Kitne minute me scraper dobara check karega (default 30 min)
SCRAPE_INTERVAL_MINUTES=30
